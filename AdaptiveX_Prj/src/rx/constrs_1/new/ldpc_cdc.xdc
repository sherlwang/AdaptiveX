# Scoped to PHY_LDPC_DEC. Clocks are generated by the board clock IP.
set ldpc_phy_clock [get_clocks -of_objects [get_ports clk]]
set ldpc_core_clock [get_clocks -of_objects [get_ports clk_core]]
# Only the first flop of each independent per-slot ownership synchronizer.
set cdc_first [get_cells -hier -quiet -filter {IS_SEQUENTIAL == 1 && (NAME =~ *in_req_sync1_reg* || NAME =~ *in_ack_sync1_reg* || NAME =~ *res_req_sync1_reg* || NAME =~ *res_ack_sync1_reg* || NAME =~ *core_error_sync1_reg*)}]
set_false_path -to [get_pins -of_objects $cdc_first -filter {REF_PIN_NAME == D}]
# Common reset asynchronously asserts the two local release synchronizers only.
set reset_async [get_pins -hier -quiet -filter {NAME =~ *release_q_reg* && (REF_PIN_NAME == CLR || REF_PIN_NAME == PRE)}]
# Only asynchronous reset pins of the two release synchronizers.
set_false_path -to $reset_async

# Bundled per-slot metadata is held until consumer ACK. Two-stage request
# synchronization and registered state-machine consumption precede sampling.
# Constrain physical settling to one receiving cycle; no independent bit sync.
# Use the SOURCE clock plus exact sequential destination classes. This also
# covers metadata inferred as LUTRAM, whose parent cell is not a startpoint.
# Only cross-domain metadata paths to these capture/check registers are bounded;
# same-clock logic is still timed by its normal clock period.
set core_meta [get_cells -hier -quiet -filter {IS_SEQUENTIAL == 1 && (NAME =~ *pair_width_reg* || NAME =~ *pair_id_reg*)}]
set_max_delay 3.255 -datapath_only -from $ldpc_phy_clock -to $core_meta
set io_meta [get_cells -hier -quiet -filter {IS_SEQUENTIAL == 1 && (NAME =~ *u_ldpc_decoder/decode_ok_reg* || NAME =~ *u_ldpc_decoder/iterations_reg* || NAME =~ *u_ldpc_decoder/group_ok_reg* || NAME =~ *u_ldpc_decoder/dout_width_reg* || NAME =~ *u_ldpc_decoder/overflow_error_reg* || NAME =~ decode_ok_reg* || NAME =~ iterations_reg* || NAME =~ group_ok_reg* || NAME =~ dout_width_reg* || NAME =~ overflow_error_reg* || NAME =~ *output_id_q_reg*)}]
set_max_delay 4.883 -datapath_only -from $ldpc_core_clock -to $io_meta
